---
// Ideas index skeleton (docs/components.md → IdeasTemplate): breadcrumb, title block, ArticleCards, AboutUsBand.
import AboutUsBand from '../components/organisms/AboutUsBand/AboutUsBand.astro';
import ArticleCard from '../components/organisms/ArticleCard/ArticleCard.astro';
import Eyebrow from '../components/atoms/Eyebrow/Eyebrow.astro';
import BreadcrumbTrail from '../components/molecules/BreadcrumbTrail/BreadcrumbTrail.astro';
import PageShell from './PageShell.astro';
import type { IdeasPageModel } from '../lib/article';
import type { ShellData } from '../lib/shell';
interface Props { page: IdeasPageModel; shell: ShellData }
const { page, shell } = Astro.props;
---
<PageShell title={page.title} description={page.description} canonical={page.canonical} jsonLd={page.jsonLd} shell={shell}>
  <div class="ideas">
    <BreadcrumbTrail items={page.crumbs} />
    <div class="ideas__head">
      <Eyebrow>{page.eyebrow}</Eyebrow>
      <h1 class="text-display">{page.h1}</h1>
      <p class="text-lead">{page.lead}</p>
    </div>
    <ul class="ideas__list">{page.items.map((it) => <li><ArticleCard {...it} headingLevel="h2" /></li>)}</ul>
    <p class="text-caption">{page.priceNote}</p>
  </div>
  <AboutUsBand data={shell.aboutUs} />
</PageShell>

<style>
  .ideas { max-width: var(--container-page); margin: 0 auto; padding: var(--space-5) var(--page-gutter) 0; display: flex; flex-direction: column; gap: var(--space-5); }
  .ideas__head { max-width: var(--container-narrow); display: flex; flex-direction: column; gap: var(--space-3); }
  .ideas__head p { margin: 0; }
  .ideas__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: var(--space-5); }
</style>
