---
// Compact tag (static), filter toggle, or link. Radius comes from --chip-radius (set to full in filter contexts).
import Icon from '../Icon/Icon.astro';
interface Props { kind?: 'static' | 'toggle' | 'link'; selected?: boolean; icon?: string; href?: string; class?: string; [key: string]: unknown }
const { kind = 'static', selected = false, icon, href, class: className, ...rest } = Astro.props;
const classes = ['chip', 'text-caption-strong', `chip--${kind}`, className];
---
{kind === 'link' ? (
  <a href={href} class:list={classes} {...rest}>{icon && <Icon name={icon} tone="secondary" />}<slot /></a>
) : kind === 'toggle' ? (
  <button type="button" class:list={classes} aria-pressed={selected ? 'true' : 'false'} {...rest}>{icon && <Icon name={icon} />}<slot /></button>
) : (
  <span class:list={classes} {...rest}>{icon && <Icon name={icon} tone="secondary" />}<slot /></span>
)}

<style>
  .chip {
    display: inline-flex; align-items: center; gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface-card); color: var(--color-text-primary);
    border: var(--border-width) solid var(--color-border-subtle); border-radius: var(--chip-radius, var(--radius-control));
    text-decoration: none;
  }
  .chip--toggle, .chip--link { min-height: var(--tap-size-min); padding: 0 var(--space-4); cursor: pointer; transition: background-color var(--duration-fast) var(--easing-standard); }
  .chip--link { border-color: var(--color-border-default); }
  .chip--toggle[aria-pressed='true'] { background: var(--color-action-neutral); color: var(--color-action-neutral-text); border-color: var(--color-action-neutral); }
  @media (hover: hover) { .chip--toggle:not([aria-pressed='true']):hover, .chip--link:hover { background: var(--color-surface-sunken); } }
</style>
