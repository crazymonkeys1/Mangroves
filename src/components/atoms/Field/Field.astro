---
// Text input with a visible label above.
interface Props {
  label: string; name: string; type?: 'text' | 'email' | 'tel' | 'search';
  inputmode?: 'text' | 'email' | 'tel' | 'search'; autocomplete?: string; required?: boolean;
  tone?: 'default' | 'inverse'; id?: string; class?: string;
}
const { label, name, type = 'text', inputmode, autocomplete, required = false, tone = 'default', id = `field-${name}`, class: className } = Astro.props;
---
<label class:list={['field', `field--${tone}`, className]} for={id}>
  <span class="field__label text-caption">{label}</span>
  <input class="field__input text-body-strong" id={id} name={name} type={type} inputmode={inputmode} autocomplete={autocomplete} required={required} />
</label>

<style>
  .field { display: flex; flex-direction: column; gap: var(--space-2); }
  .field__input {
    width: 100%; height: calc(var(--tap-size-min) + var(--space-2)); padding: 0 var(--space-4);
    border-radius: var(--radius-control); border: var(--border-width) solid var(--color-border-default);
    background: var(--color-surface-card); color: var(--color-text-primary);
  }
  .field--inverse .field__label { color: var(--color-text-inverse-secondary); }
  .field--inverse .field__input { border-color: transparent; }
</style>
