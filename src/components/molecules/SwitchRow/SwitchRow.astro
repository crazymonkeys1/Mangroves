---
// A boolean setting: icon + label + switch. The whole row is the target.
import Icon from '../../atoms/Icon/Icon.astro';
import Switch from '../../atoms/Switch/Switch.astro';
interface Props { icon: string; label: string; pressed?: boolean; compact?: boolean; class?: string; [key: string]: unknown }
const { icon, label, pressed = false, compact = false, class: className, ...rest } = Astro.props;
---
<button type="button" class:list={['switch-row', 'text-body-strong', compact && 'switch-row--compact', className]} aria-pressed={pressed ? 'true' : 'false'} {...rest}>
  <span class="switch-row__label"><Icon name={icon} size="control" />{label}</span>
  <Switch />
</button>

<style>
  .switch-row {
    width: 100%; min-height: calc(var(--tap-size-min) + var(--space-2));
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-3);
    padding: 0 var(--space-4); border-radius: var(--radius-control); border: var(--border-width) solid var(--color-border-default);
    background: var(--color-surface-card); color: var(--color-text-primary); cursor: pointer; white-space: nowrap;
  }
  .switch-row--compact { width: auto; flex-shrink: 0; min-height: calc(var(--tap-size-min) + var(--space-1)); border-radius: var(--chip-radius, var(--radius-control)); }
  .switch-row__label { display: inline-flex; align-items: center; gap: var(--space-2); }
</style>
