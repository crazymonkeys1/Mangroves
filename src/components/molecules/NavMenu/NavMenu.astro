---
// Mobile navigation: icon-only button (two bars → ×) opening a full-width panel. Native <details>.
interface Props { links: { href: string; label: string }[] }
const { links } = Astro.props;
---
<details class="nav-menu" data-nav-menu>
  <summary class="nav-menu__button" aria-label="Menu">
    <span class="nav-menu__bars" aria-hidden="true"><span class="nav-menu__bar"></span><span class="nav-menu__bar"></span></span>
  </summary>
  <nav class="nav-menu__panel" aria-label="Navigation principale">
    {links.map((l) => <a class="nav-menu__link text-body-strong" href={l.href}>{l.label}<span aria-hidden="true">→</span></a>)}
  </nav>
</details>

<style>
  .nav-menu__button {
    width: var(--tap-size-min); height: var(--tap-size-min); margin-right: calc(-1 * var(--space-3));
    display: flex; align-items: center; justify-content: center; border-radius: var(--radius-control);
  }
  @media (hover: hover) { .nav-menu__button:hover { background: var(--color-surface-sunken); } }
  .nav-menu__bars { display: flex; flex-direction: column; gap: 6px; }
  .nav-menu__bar { display: block; width: calc(var(--space-5) - var(--space-1)); height: 2px; border-radius: var(--radius-tick); background: var(--color-text-primary); transition: transform var(--duration-fast) var(--easing-standard); }
  .nav-menu[open] .nav-menu__bar:first-child { transform: translateY(4px) rotate(45deg); }
  .nav-menu[open] .nav-menu__bar:last-child { transform: translateY(-4px) rotate(-45deg); }
  .nav-menu__panel {
    position: absolute; top: 100%; left: 0; right: 0; z-index: var(--z-dropdown);
    display: flex; flex-direction: column; padding: 0 var(--page-gutter) var(--space-2);
    background: var(--color-surface-page); border-bottom: var(--border-width) solid var(--color-border-default); box-shadow: var(--elevation-overlap);
  }
  .nav-menu__link {
    display: flex; align-items: center; justify-content: space-between; min-height: calc(var(--tap-size-min) + var(--space-2));
    border-top: var(--border-width) solid var(--color-border-subtle); text-decoration: none;
  }
</style>
