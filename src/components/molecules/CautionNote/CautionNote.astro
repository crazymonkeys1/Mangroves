---
// Marks estimated or unverified data ("À confirmer").
import Icon from '../../atoms/Icon/Icon.astro';
interface Props { class?: string }
---
<p class:list={['caution-note', 'text-caption', 'is-caution', Astro.props.class]}>
  <Icon name="info" /><span><slot>À confirmer</slot></span>
</p>

<style>
  .caution-note {
    margin: 0; display: inline-flex; align-items: flex-start; gap: var(--space-2); align-self: flex-start;
    padding: var(--space-1) var(--space-3); border-radius: var(--radius-control); background: var(--color-surface-caution);
  }
  .caution-note :global(.icon) { margin-top: var(--space-1); }
</style>
