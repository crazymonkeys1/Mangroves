---
// Compact secondary action: icon + one word. Full wording in aria-label.
import Icon from '../../atoms/Icon/Icon.astro';
interface Props { href: string; icon: string; label: string; ariaLabel: string; external?: boolean }
const { href, icon, label, ariaLabel, external = false } = Astro.props;
---
<a class="action-tile text-caption-strong" href={href} aria-label={ariaLabel} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
  <Icon name={icon} tone="secondary" />{label}
</a>

<style>
  .action-tile {
    display: inline-flex; align-items: center; gap: var(--space-2); min-height: var(--tap-size-min);
    padding: 0 var(--space-3); border-radius: var(--radius-control); background: var(--color-surface-inset);
    text-decoration: none; transition: background-color var(--duration-fast) var(--easing-standard);
  }
  @media (hover: hover) { .action-tile:hover { background: var(--color-surface-sunken); } }
</style>
