---
// Breadcrumb + folded sources and photo credits (#sources).
import Eyebrow from '../../atoms/Eyebrow/Eyebrow.astro';
import BreadcrumbTrail from '../../molecules/BreadcrumbTrail/BreadcrumbTrail.astro';
interface Props {
  crumbs: { label: string; href?: string }[];
  sources: { label: string; url: string; typeLabel: string }[];
  credits: { caption: string; credit: string; license: string; url: string }[];
}
const { crumbs, sources, credits } = Astro.props;
---
<section class="sources-bar" aria-label="Fil d'Ariane et sources">
  <BreadcrumbTrail items={crumbs} />
  <details class="sources-bar__details" id="sources">
    <summary class="sources-bar__toggle text-caption-strong">Sources et crédits <span class="sources-bar__chevron" aria-hidden="true">▸</span></summary>
    <div class="sources-bar__body">
      <div class="sources-bar__column">
        <Eyebrow tone="secondary" as="h2">Sources · {sources.length + credits.length} références</Eyebrow>
        <ul class="sources-bar__list">
          {sources.map((s) => <li class="sources-bar__source"><span class="sources-bar__type text-eyebrow is-secondary">{s.typeLabel}</span><a class="text-caption-strong" href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}
        </ul>
      </div>
      <div class="sources-bar__column">
        <Eyebrow tone="secondary" as="h2">Crédits photos</Eyebrow>
        <ul class="sources-bar__list">
          {credits.map((c) => <li class="text-caption"><a class="text-caption-strong" href={c.url} target="_blank" rel="noopener">{c.caption}</a> · {c.credit}{c.license && <> · {c.license}</>}</li>)}
        </ul>
      </div>
    </div>
  </details>
</section>

<style>
  .sources-bar { border-top: var(--border-width) solid var(--color-border-default); margin-top: var(--space-6); padding: var(--space-4) 0 var(--section-padding-bottom); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0 var(--space-5); }
  .sources-bar__details[open] { flex-basis: 100%; }
  .sources-bar__toggle { display: inline-flex; align-items: center; gap: var(--space-1); min-height: var(--tap-size-min); color: var(--color-text-secondary); }
  .sources-bar__chevron { display: inline-block; transition: transform var(--duration-fast) var(--easing-standard); }
  .sources-bar__details[open] .sources-bar__chevron { transform: rotate(90deg); }
  .sources-bar__body { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: var(--space-5) var(--space-7); padding: var(--space-2) 0 var(--space-1); }
  .sources-bar__column { display: flex; flex-direction: column; gap: var(--space-3); }
  .sources-bar__column h2 { margin: 0; }
  .sources-bar__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .sources-bar__source { display: flex; align-items: baseline; gap: var(--space-3); min-width: 0; }
  .sources-bar__type { flex-shrink: 0; width: 96px; }
</style>
