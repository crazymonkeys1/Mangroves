---
// Full-screen photo viewer (native <dialog>): Esc closes, arrows and swipe change photo, credit and source shown.
import IconButton from '../../atoms/IconButton/IconButton.astro';
interface Props { images: { src: string; alt: string; caption: string; credit: string }[] }
const { images } = Astro.props;
---
<dialog class="lightbox" data-lightbox aria-label="Photos">
  <div class="lightbox__frame">
    <img class="lightbox__image" alt="" data-lightbox-image />
    <p class="lightbox__caption text-caption" data-lightbox-caption aria-live="polite"></p>
  </div>
  <IconButton class="lightbox__close" glyph="✕" label="Fermer" tone="inverse" data-lightbox-close />
  {images.length > 1 && <IconButton class="lightbox__prev" glyph="‹" label="Photo précédente" tone="inverse" data-lightbox-prev />}
  {images.length > 1 && <IconButton class="lightbox__next" glyph="›" label="Photo suivante" tone="inverse" data-lightbox-next />}
  <script type="application/json" data-lightbox-data set:html={JSON.stringify(images)} />
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (dialog) {
    const images: { src: string; alt: string; caption: string; credit: string }[] = JSON.parse(dialog.querySelector('[data-lightbox-data]')?.textContent || '[]');
    const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-image]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    let index = 0;
    const show = (i: number) => {
      index = (i + images.length) % images.length;
      const im = images[index];
      img.src = im.src; img.alt = im.alt;
      caption.textContent = `${im.caption} · Photo : ${im.credit} (${index + 1}/${images.length})`;
    };
    document.addEventListener('lightbox:open', (e) => {
      if (!images.length) return;
      show((e as CustomEvent<{ index: number }>).detail.index);
      dialog.showModal();
    });
    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    let startX = 0;
    dialog.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .lightbox { width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: var(--space-8) var(--page-gutter); border: 0; background: transparent; }
  .lightbox::backdrop { background: var(--color-overlay-lightbox); }
  .lightbox[open] { display: flex; align-items: center; justify-content: center; }
  .lightbox__frame { display: flex; flex-direction: column; align-items: center; gap: var(--space-3); max-width: 100%; max-height: 100%; }
  .lightbox__image { max-width: 100%; max-height: calc(100vh - 2 * var(--space-8) - var(--space-7)); object-fit: contain; border-radius: var(--radius-control); }
  .lightbox__caption { margin: 0; color: var(--color-text-inverse-secondary); text-align: center; }
  .lightbox :global(.lightbox__close) { position: fixed; top: var(--space-3); right: var(--space-3); }
  .lightbox :global(.lightbox__prev), .lightbox :global(.lightbox__next) { position: fixed; top: 50%; transform: translateY(-50%); }
  .lightbox :global(.lightbox__prev) { left: var(--space-2); }
  .lightbox :global(.lightbox__next) { right: var(--space-2); }
</style>
