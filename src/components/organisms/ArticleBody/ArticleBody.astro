---
// SEO article body (docs/components.md → ArticleBody): intro, "En bref", table of contents, essentials,
// the guide sections with a quote, then the `selection` slot, "Bon à savoir", "Avant de partir",
// the `faq` slot, "Pourquoi partir avec un guide", author and sources.
import Eyebrow from '../../atoms/Eyebrow/Eyebrow.astro';
import AlertNote from '../../molecules/AlertNote/AlertNote.astro';
import Byline from '../../molecules/Byline/Byline.astro';
import FeatureList from '../../molecules/FeatureList/FeatureList.astro';
import SectionHead from '../../molecules/SectionHead/SectionHead.astro';
import type { ArticlePageModel } from '../../../lib/article';
interface Props { data: ArticlePageModel['body'] }
const b = Astro.props.data;
---
<div class="article-body">
  <p class="text-lead">{b.intro}</p>
  <aside class="article-body__brief" aria-label="En bref">
    <Eyebrow>En bref</Eyebrow>
    <p class="text-body">{b.brief}</p>
  </aside>
  <nav class="article-body__toc" aria-label="Sommaire">
    <Eyebrow tone="secondary" as="p">Sommaire</Eyebrow>
    <ol class="article-body__toc-list">{b.toc.map((t) => <li><a class="text-body" href={t.href}>{t.label}</a></li>)}</ol>
  </nav>

  <section class="article-body__section" id="essentiel" aria-labelledby="h-essentiel">
    <h2 class="text-heading" id="h-essentiel">L'essentiel</h2>
    <ul class="article-body__essentials">{b.essentials.map((e) => <li class="text-body"><strong>{e.lead}</strong> {e.text}</li>)}</ul>
  </section>

  <section class="article-body__section" id="le-guide" aria-labelledby="h-le-guide">
    <SectionHead eyebrow="Le guide" title={b.guideH2} id="h-le-guide" />
    {b.sections.map((s) => (
      <div class="article-body__part">
        <h3 class="text-body-strong">{s.title}</h3>
        {s.paragraphs.map((p) => <p class="text-body">{p}</p>)}
      </div>
    ))}
    <blockquote class="article-body__quote">
      <p class="text-quote">« {b.quote.text} »</p>
      <cite class="text-caption">{b.quote.by}</cite>
    </blockquote>
  </section>
  <p class="article-body__ornament text-title" aria-hidden="true">···</p>

  <slot name="selection" />

  <section class="article-body__know" id="bon-a-savoir" aria-labelledby="h-bon-a-savoir">
    <Eyebrow tone="secondary" as="h2"><span id="h-bon-a-savoir">Bon à savoir</span></Eyebrow>
    <dl class="article-body__know-list">
      {b.know.map((k) => <div class="article-body__know-row"><dt class="text-caption">{k.label}</dt><dd class="text-body-strong">{k.value}</dd></div>)}
    </dl>
  </section>

  <section class="article-body__section" id="avant-de-partir" aria-labelledby="h-avant-de-partir">
    <h2 class="text-heading" id="h-avant-de-partir">Avant de partir</h2>
    <AlertNote headline="À lire avant de partir"><p>{b.before}</p></AlertNote>
  </section>
  <p class="article-body__ornament text-title" aria-hidden="true">···</p>

  <slot name="faq" />

  <section class="article-body__guide" id="avec-un-guide" aria-labelledby="h-avec-un-guide">
    <SectionHead eyebrow="Avec un guide" title="Pourquoi partir avec un guide ?" id="h-avec-un-guide" />
    <p class="text-body">{b.whyGuide.text}</p>
    <FeatureList items={b.whyGuide.tiles} />
    <p class="article-body__links">
      <a class="text-body-strong" href={b.whyGuide.toursHref}>Voir les sorties guidées</a>
      <a class="text-body-strong" href="#qui-sommes-nous">Qui sommes-nous</a>
    </p>
  </section>

  <footer class="article-body__author">
    <Byline photos={b.author.photos} size={48} text={b.author.name} />
    <p class="text-caption">{b.author.bio}</p>
    <p class="article-body__sources text-caption">
      <span>Sources :</span>
      {b.sources.map((s) => <a href={s.url} target="_blank" rel="noopener">{s.label}</a>)}
    </p>
  </footer>
</div>

<style>
  .article-body { display: flex; flex-direction: column; gap: var(--space-6); }
  .article-body p, .article-body h2, .article-body h3 { margin: 0; }
  .article-body__brief { background: var(--color-surface-brand-soft); border-radius: var(--radius-container); padding: var(--card-padding); display: flex; flex-direction: column; gap: var(--space-2); }
  .article-body__toc { border-left: 2px solid var(--color-border-default); padding: var(--space-1) 0 var(--space-1) var(--space-5); display: flex; flex-direction: column; gap: var(--space-1); }
  .article-body__toc-list { margin: 0; padding-left: var(--space-5); }
  .article-body__toc-list li::marker { color: var(--color-text-secondary); }
  .article-body__toc-list a { display: inline-flex; align-items: center; min-height: var(--tap-size-min); }
  .article-body__section { display: flex; flex-direction: column; gap: var(--space-4); }
  .article-body__essentials { list-style: none; margin: 0; padding: 0; }
  .article-body__essentials li { padding: var(--space-3) 0 var(--space-3) var(--space-5); border-top: var(--border-width) solid var(--color-border-default); position: relative; }
  .article-body__essentials li::before { content: ''; position: absolute; left: 0; top: calc(var(--space-3) + var(--space-2)); width: var(--space-2); height: var(--space-2); border-radius: var(--radius-full); background: var(--color-action-primary); }
  .article-body__part { display: flex; flex-direction: column; gap: var(--space-2); }
  .article-body__quote { margin: var(--space-3) 0 0; border-left: 3px solid var(--color-action-primary); padding: var(--space-1) 0 var(--space-1) var(--space-5); display: flex; flex-direction: column; gap: var(--space-2); }
  .article-body__quote cite { font-style: normal; }
  .article-body__ornament { text-align: center; color: var(--color-text-secondary); letter-spacing: .6em; }
  .article-body__know { background: var(--color-surface-card); border: var(--border-width) solid var(--color-border-default); border-radius: var(--radius-container); padding: var(--card-padding); display: flex; flex-direction: column; gap: var(--space-2); }
  .article-body__know-list { margin: 0; }
  .article-body__know-row { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-1); padding: var(--space-3) 0; border-top: var(--border-width) solid var(--color-border-default); }
  @media (min-width: 600px) { .article-body__know-row { grid-template-columns: minmax(120px, 170px) minmax(0, 1fr); gap: var(--space-4); } }
  .article-body__know-row dd { margin: 0; }
  .article-body__guide { background: var(--color-surface-card); border: var(--border-width) solid var(--color-border-default); border-radius: var(--radius-container); padding: var(--card-padding); display: flex; flex-direction: column; gap: var(--space-4); }
  .article-body__links { display: flex; flex-wrap: wrap; gap: 0 var(--space-5); }
  .article-body__links a { display: inline-flex; align-items: center; min-height: var(--tap-size-min); }
  .article-body__author { border-top: var(--border-width) solid var(--color-border-default); padding-top: var(--space-5); display: flex; flex-direction: column; gap: var(--space-3); }
  .article-body__sources { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-4); }
</style>
