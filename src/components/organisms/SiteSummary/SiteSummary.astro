---
// "Aperçu" (#essentiel): signature, intro, guide tip, name story, "Bon à savoir", site alert.
import Avatar from '../../atoms/Avatar/Avatar.astro';
import Chip from '../../atoms/Chip/Chip.astro';
import Eyebrow from '../../atoms/Eyebrow/Eyebrow.astro';
import Icon from '../../atoms/Icon/Icon.astro';
import AlertNote from '../../molecules/AlertNote/AlertNote.astro';
import CautionNote from '../../molecules/CautionNote/CautionNote.astro';
import SectionHead from '../../molecules/SectionHead/SectionHead.astro';
import type { SitePageModel } from '../../../lib/site-page';
interface Props { data: SitePageModel['summary'] }
const { h2, answer, sig, paragraphs, tip, nameStory, knowRows, alert } = Astro.props.data;
---
<section class="site-summary" id="essentiel" aria-labelledby="h-essentiel">
  <SectionHead eyebrow="Aperçu" title={h2} id="h-essentiel" />
  {/* The opening answer: same sentence as the meta description and JSON-LD description, quotable alone. */}
  <p class="text-lead">{answer}</p>
  {sig && <blockquote class="site-summary__signature"><p class="text-quote">{sig}</p></blockquote>}
  {paragraphs.map((p) => <><p class="text-body">{p.text}</p>{p.estimated && <CautionNote>Chiffre estimé, à confirmer</CautionNote>}</>)}

  {tip && (
    <aside class="site-summary__tip" aria-label={tip.label}>
      {tip.photo ? <Avatar src={tip.photo} size={48} /> : <span class="site-summary__tip-mark"><Icon name="leaf" size="control" tone="brand" /></span>}
      <div class="site-summary__tip-body">
        <Eyebrow>{tip.label}</Eyebrow>
        <p class="text-quote">{tip.text}</p>
      </div>
    </aside>
  )}

  {nameStory && (
    <div class="site-summary__block">
      <Eyebrow tone="secondary" as="h3">Pourquoi ce nom</Eyebrow>
      <p class="text-body">{nameStory.text}</p>
      {nameStory.estimated && <CautionNote>Histoire à confirmer</CautionNote>}
    </div>
  )}

  {knowRows.length > 0 && (
    <div class="site-summary__know">
      <Eyebrow tone="secondary" as="h3">Bon à savoir</Eyebrow>
      <dl class="site-summary__know-list">
        {knowRows.map((k) => (
          <div class="site-summary__know-row">
            <dt class="site-summary__know-label text-caption"><span class="site-summary__know-icon"><Icon name={k.icon} tone="secondary" /></span>{k.label}</dt>
            <dd class="site-summary__know-value">
              {k.chips && <span class="site-summary__chips">{k.chips.map((c) => <Chip kind="tag">{c}</Chip>)}</span>}
              {k.main && <span class="text-body">{k.main}</span>}
              {k.note && <span class="text-caption">{k.note}</span>}
              {k.estimated && <CautionNote />}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  )}

  {alert && (
    <AlertNote id="alerte" headline={alert.title}>
      <p>{alert.text}</p>
      {alert.items.length > 0 && <ul class="site-summary__alert-items">{alert.items.map((it) => <li>{it}</li>)}</ul>}
    </AlertNote>
  )}
</section>

<style>
  .site-summary { padding: var(--space-6) 0 var(--section-padding-bottom); display: flex; flex-direction: column; gap: var(--space-4); min-width: 0; }
  .site-summary__signature { margin: var(--space-1) 0; padding: var(--space-1) 0 var(--space-1) var(--space-5); border-left: 2px solid var(--color-text-brand); }
  .site-summary__tip { background: var(--color-surface-brand-soft); border-radius: var(--radius-container); padding: var(--card-padding); display: flex; gap: var(--space-4); align-items: flex-start; }
  .site-summary__tip-mark { width: calc(var(--space-7) + var(--space-2)); height: calc(var(--space-7) + var(--space-2)); flex-shrink: 0; border-radius: var(--radius-full); background: var(--color-surface-card); display: flex; align-items: center; justify-content: center; }
  .site-summary__tip-body { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
  .site-summary__block { display: flex; flex-direction: column; gap: var(--space-2); }
  .site-summary__block h3, .site-summary__know h3 { margin: 0; }
  .site-summary__know { background: var(--color-surface-card); border: var(--border-width) solid var(--color-border-default); border-radius: var(--radius-container); padding: var(--card-padding) var(--card-padding) var(--space-1); display: flex; flex-direction: column; gap: var(--space-2); }
  .site-summary__know-list { margin: 0; display: flex; flex-direction: column; }
  .site-summary__know-row { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); padding: var(--space-3) 0; border-top: var(--border-width) solid var(--color-border-subtle); align-items: flex-start; }
  .site-summary__know-label { flex: 0 0 190px; display: flex; align-items: center; gap: var(--space-3); }
  .site-summary__know-icon { width: calc(var(--space-6) - var(--space-1)); height: calc(var(--space-6) - var(--space-1)); border-radius: var(--radius-control); background: var(--color-surface-inset); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .site-summary__know-value { margin: 0; flex: 1 1 260px; min-width: 0; display: flex; flex-direction: column; gap: var(--space-1); }
  .site-summary__chips { display: flex; flex-wrap: wrap; gap: var(--space-2); --chip-radius: var(--radius-control); }
  .site-summary__alert-items { margin: 0; padding-left: var(--space-5); }
  .site-summary__alert-items li::marker { color: var(--color-action-primary); }
</style>
